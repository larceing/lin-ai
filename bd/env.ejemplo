# Añadir estas líneas al .env de la carpeta de la app (junto a app.py).
# El .env no se comparte ni se sube a ningún sitio. Usuarios de SOLO LECTURA.

# A3ERP · SQL Server 2017
A3_SERVIDOR=192.168.10.209
A3_BD=SG
A3_USUARIO=
A3_CLAVE=
# Opcional: A3_PUERTO=1433 · A3_DRIVER=ODBC Driver 18 for SQL Server
# Opcional: A3_AISLAMIENTO=READ COMMITTED  (por defecto READ UNCOMMITTED, para no bloquear el ERP)

# Innertia · MariaDB
INN_SERVIDOR=192.168.10.215
INN_PUERTO=3306
INN_BD=almacenmultiforte
INN_USUARIO=
INN_CLAVE=

# Límites por consulta
BD_MAX_FILAS=500
BD_TIEMPO_MAX_S=30
