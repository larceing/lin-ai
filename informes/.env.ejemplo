# Copia estas líneas al .env de la carpeta de Lin-AI (junto a app.py) y rellena los valores.
# El .env nunca se comparte ni se sube a ningún sitio.

# Correo (opcional). Apagado salvo que ponga CORREO_ACTIVO=si
CORREO_ACTIVO=no

# Correo de desarrollo de IONOS. Si se dejan vacíos, se usa el buzón ya configurado en
# Sistema_Compras_IA\Motor_Analisis\.env (SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASSWORD, MAIL_FROM).
SMTP_HOST=smtp.ionos.es
SMTP_PUERTO=587
SMTP_USUARIO=
SMTP_CLAVE=
SMTP_REMITENTE=

# A quién se puede enviar: direcciones completas o dominios enteros con @, separados por comas.
# Si se deja vacío, solo se permite MAIL_TO_DEFAULT del Motor_Analisis.
CORREO_PERMITIDOS=

# Mientras no ponga "si", los correos se guardan como .eml en informes_generados/ y no se envían
CORREO_ENVIO_REAL=no

# Filas de muestra que ve la IA para redactar el informe (0 = solo columnas y totales)
INFORMES_FILAS_A_IA=10
